{
  "expo": {
    "name": "Kapas ki Pukaar",
    "slug": "kapas-ki-pukaar",
    "scheme": "kapas",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F3E8"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "org.puwf.kapas",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Kapas ki Pukaar uses your location only when you choose it to identify where the reported incident happened."
      }
    },
    "android": {
      "package": "org.puwf.kapas",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/monochrome-icon.png",
        "backgroundColor": "#F7F3E8"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-av",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Kapas ki Pukaar to use your location only when you choose it for a complaint."
        }
      ],
      "expo-secure-store",
      "./plugins/with-disabled-native-rtl"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "newArchEnabled": false,
    "extra": {
      "router": {},
      "eas": {
        "projectId": "68fabe6e-1b8a-4035-ab6b-255b11ab411f"
      }
    },
    "owner": "minhalawais1"
  }
}
